# Copy this file to web/.env.local for local development.
# Example: cp web/.env.example web/.env.local
# Never commit web/.env.local (it may contain secrets).

NODE_ENV=development

# --- Google sign-in (required for normal login path) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=76122627239-d2hk4fjp9984f5ik35i8utmtbh1bsmj0.apps.googleusercontent.com
GOOGLE_CLIENT_ID=76122627239-d2hk4fjp9984f5ik35i8utmtbh1bsmj0.apps.googleusercontent.com

# --- Optional / currently unused in this codebase ---
# Present for compatibility with some OAuth setups, but not read by current app code.
GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_ENABLE_DEV_LOGIN=

# --- JWT used by web auth API routes (/api/auth/google, /api/auth/token, /api/auth/refresh) ---
AUCTOR_JWT_SECRET=dev-secret-change-later-dev-secret-change-later
AUCTOR_JWT_ISSUER=auctor-auth
AUCTOR_JWT_AUDIENCE=definition-service,execution-service

# Optional fallback JWT secrets (used if AUCTOR_JWT_SECRET is missing)
DEFINITION_JWT_SECRET=dev-secret-change-later-dev-secret-change-later
EXECUTION_JWT_SECRET=dev-secret-change-later-dev-secret-change-later

# --- API routing from Next.js server routes ---
DEFINITION_SERVICE_URL=http://localhost:8081
EXECUTION_SERVICE_URL=http://localhost:8082

# --- Frontend telemetry ---
NEXT_PUBLIC_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces

# --- Optional admin emails (comma-separated) ---
ADMIN_EMAILS=admin@example.com
